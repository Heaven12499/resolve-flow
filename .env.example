DATABASE_URL=mysql+pymysql://resolve_flow:resolve_flow@localhost:3306/resolve_flow?charset=utf8mb4
AUTO_CREATE_TABLES=false
SEED_DEMO_DATA=true
AI_PROVIDER=rules
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash
DEEPSEEK_TIMEOUT_SECONDS=12
RAG_ENABLED=true
CHROMA_HOST=chroma
CHROMA_PORT=8000
CHROMA_COLLECTION_NAME=resolveflow_knowledge_chunks
RAG_MIN_SCORE=0.25
EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5
EMBEDDING_DIMENSION=512
# Set AUTH_ENABLED=true outside local demos. Use long, unique passwords and a
# random AUTH_SECRET; never commit real values.
AUTH_ENABLED=false
AUTH_SECRET=
AUTH_ADMIN_USERNAME=admin
AUTH_ADMIN_PASSWORD=
AUTH_SUPERVISOR_USERNAME=supervisor
AUTH_SUPERVISOR_PASSWORD=
AUTH_AGENT_USERNAME=agent
AUTH_AGENT_PASSWORD=
PROCESSING_MAX_ATTEMPTS=3
